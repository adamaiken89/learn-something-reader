{
	"name": "coursereader",
	"version": "1.0.0",
	"type": "module",
	"description": "CourseReader - desktop study app",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build && electrobun build --env=stable",
		"build:canary": "vite build && electrobun build --env=canary",
		"test": "bun test --path-ignore-patterns 'e2e/**' --path-ignore-patterns 'src/mainview/__e2e__/**'",
		"e2e": "bash scripts/e2e.sh",
		"e2e:update": "bash scripts/e2e.sh --update",
		"fix": "oxlint src --fix --type-aware && oxfmt 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.css' 'src/**/locales/*.json' --write",
		"check": "tsc --noEmit && oxlint src --type-aware && oxfmt 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.css' 'src/**/locales/*.json' --check",
		"knip": "knip",
		"lint": "oxlint src --type-aware && oxfmt 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.css' 'src/**/locales/*.json' --check",
		"prepare": "husky"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^26.3.6",
		"js-yaml": "^5.3.0",
		"lucide-react": "^1.33.0",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^11.17.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.11",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"sonner": "^2.0.8",
		"unified": "^11.0.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/bun": "^1.3.14",
		"@types/mdast": "^4.0.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.0.5",
		"autoprefixer": "^10.5.4",
		"concurrently": "^9.2.4",
		"electrobun": "2.0.1",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"happy-dom": "^20.11.6",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"oxfmt": "0.64.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "7",
		"postcss": "^8.5.26",
		"tailwindcss": "^3.4.19",
		"vite": "^8.2.1"
	}
}
