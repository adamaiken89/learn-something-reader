{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/mainview/*"],
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main/*": ["./.hutch/devkit/api/sdks/main/entries/*.ts"],
			"electrobun/bun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
		},
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["*"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src", "electrobun.config.ts", "hutch.config.ts"],
	"exclude": ["node_modules", "dist", "build"]
}
